# Public Cloudflare R2 delivery URL used by the website to display images.
# Use the bucket's custom domain or public r2.dev URL.
# Do NOT use the S3 API endpoint here; it requires authenticated requests.
# Point this at the R2 directory containing the former public/images contents.
# For example, /images/logo.webp becomes ${NEXT_PUBLIC_R2_PUBLIC_URL}/logo.webp.
# Do not add a trailing slash.
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.cerid.so

# Cloudflare R2 credentials for uploads and server-side maintenance only.
# Never expose these values with the NEXT_PUBLIC_ prefix.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cerid-website

# S3-compatible API endpoint. This is not the public image delivery URL.
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
